{
  "expo": {
    "name": "Gym Duo Tracker",
    "owner": "theraven458",
    "slug": "gym-duo-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Accès à tes photos pour ton journal de progression.",
          "cameraPermission": "Accès à ta caméra pour prendre des photos de progression."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymduotracker.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Accès à ta caméra pour prendre des photos de progression.",
        "NSPhotoLibraryUsageDescription": "Accès à tes photos pour ton journal de progression."
      }
    },
    "android": {
      "package": "com.gymduotracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7fa74c3d-8c2d-4118-b889-8637a120d3f6"
    },
    "extra": {
      "eas": {
        "projectId": "7fa74c3d-8c2d-4118-b889-8637a120d3f6"
      }
    }
  }
}
